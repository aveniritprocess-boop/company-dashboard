rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Recommendation 9: isActiveUser check
    // Block disabled, locked, deleted, or portal-revoked accounts at the database layer
    function isUserActive() {
      let data = getUserData();
      return isSignedIn() && data != null &&
             data.get('is_active', true) == true &&
             data.get('is_locked', false) == false &&
             data.get('is_deleted', false) == false &&
             data.get('portal_access', true) == true;
    }
    
    function isRole(role) {
      return isUserActive() && getUserData().role == role;
    }
    
    function isCEO() {
      return isRole('ceo') || isRole('md');
    }
    
    function isAdmin() {
      return isCEO() || isRole('admin') || isRole('super_admin');
    }
    
    // AGM sits directly above manager in the business hierarchy
    // (employee < team_lead < manager < agm < md < ceo). It is granted exactly
    // manager-level database access and is deliberately NOT part of isAdmin()
    // or isCEO(), so it gains no role management, no user-document writes, and
    // no backup/monitoring access.
    function isManager() {
      return isRole('manager') || isRole('agm');
    }

    function isHR() {
      return isRole('hr') || isRole('hr_admin') || isRole('hr_executive');
    }

    function isManagerOrAbove() {
      return isAdmin() || isManager() || isHR();
    }

    function isAssignedToUser(taskData, userId) {
      return taskData.assignedTo == userId || 
             (taskData.assignedTo is list && userId in taskData.assignedTo) ||
             taskData.assigned_to == userId || 
             (taskData.assigned_to is list && userId in taskData.assigned_to);
    }
    
    // Tasks are company-wide readable by any active employee.
    //
    // This is deliberate: the Recent Tasks feed is a company-wide activity view,
    // so a task between two other people must be visible to everyone. The
    // previous rule limited reads to admins, the assigner and the assignees,
    // which meant a non-admin's company-wide query was rejected outright
    // (Firestore fails the whole query if any matched document is unreadable) —
    // tasks generated notifications but never appeared in the feed.
    //
    // Scope of this change is READ on /tasks only. Task create/update/delete
    // rules are unchanged, and no other collection is affected: a user still
    // cannot edit a task they do not own, change roles, or read private
    // collections such as users, audit_logs or attendance.
    function canReadTask() {
      return isUserActive();
    }

    // For subcollection reads where we need to check the parent task
    function canAccessParentTask(taskId) {
      let taskData = get(/databases/$(database)/documents/tasks/$(taskId)).data;
      return isUserActive() && (
        isAdmin() ||
        taskData.assignedBy == request.auth.uid ||
        taskData.assigned_by == request.auth.uid ||
        isAssignedToUser(taskData, request.auth.uid)
      );
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (
        (request.auth.uid == userId && (
          resource == null || (
            resource.data.get('is_active', true) == true &&
            resource.data.get('is_locked', false) == false &&
            resource.data.get('is_deleted', false) == false &&
            resource.data.get('portal_access', true) == true
          )
        )) ||
        (request.auth.uid != userId && isManagerOrAbove())
      );
      
      allow list: if isUserActive() && (isRole('ceo') || isRole('md') || isRole('super_admin') || isRole('admin') || isRole('manager'));
      
      // Allow new users to create their user record on first sign-in
      allow create: if isSignedIn() && request.auth.uid == userId && (
        !request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'employee'
      );
      
      // Issue #2 Fix: Whitelist-based validation to prevent privilege escalation
      // SEC-2 fix: the previous hardcoded-email bypass here granted unrestricted
      // writes to ANY user document to a single fixed email address — a standing
      // backdoor exploitable by anyone who compromises that account. Recovery of
      // a locked-out CEO account must go through a server-side Admin SDK script
      // (see scripts/make_ceo_admin.js), which bypasses these rules by design and
      // is not reachable from the client.
      allow update: if isUserActive() && (
        isAdmin() ||
        (
          request.auth.uid == userId && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'displayName', 'mobile', 'phone', 'profile_photo', 'photoURL',
            'notification_preferences', 'address', 'emergency_contact', 'gender', 
            'updatedAt', 'updated_at', 'active_attendance_session_id', 
            'twoFactorSecret', 'twoFactorEnabled', 'last_login_at', 
            'lastLoginAt', 'must_change_password'
          ]) && 
          // Validate that modifying active_attendance_session_id is only possible 
          // alongside a valid attendance transaction
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['active_attendance_session_id']) ||
            (
              request.resource.data.active_attendance_session_id != null && 
              getAfter(/databases/$(database)/documents/users/$(userId)/attendance/$(request.resource.data.active_attendance_session_id)).data.status == "active"
            ) ||
            (
              request.resource.data.active_attendance_session_id == null && 
              resource.data.active_attendance_session_id != null && 
              getAfter(/databases/$(database)/documents/users/$(userId)/attendance/$(resource.data.active_attendance_session_id)).data.status == "completed"
            )
          )
        )
      );
      
      allow delete: if isAdmin() && resource.data.role != 'ceo';

      // Recommendation 1 & 2: Attendance & Todos subcollections under users/{userId}
      match /attendance/{attendanceId} {
        allow read: if isUserActive() && (
          isAdmin() || isHR() || userId == request.auth.uid ||
          (isManager() && get(/databases/$(database)/documents/users/$(userId)).data.reporting_manager_id == request.auth.uid)
        );

        // Clock-in: only the user themselves may create a record.
        // clockInAt must equal server time (prevents backdating/future-dating).
        // clockOutAt and durationSeconds must not be present on create (clock-out fields).
        // status must be "active" to prevent creating a pre-completed record.
        allow create: if isUserActive() &&
          request.auth.uid == userId &&
          request.resource.data.clockInAt == request.time &&
          !request.resource.data.keys().hasAny(['durationSeconds', 'clockOutAt']) &&
          request.resource.data.status == "active";

        // Clock-out: only the user themselves (or their manager, or admin) may update.
        // Writable fields are restricted to: clockOutAt, clockOutImageUrl, durationSeconds, status.
        // Immutable fields (clockInAt, createdAt) cannot be changed.
        allow update: if isUserActive() && (
          isAdmin() || isHR() || (
            (
              userId == request.auth.uid ||
              (isManager() && get(/databases/$(database)/documents/users/$(userId)).data.reporting_manager_id == request.auth.uid)
            ) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['clockOutAt', 'clockOutImageUrl', 'durationSeconds', 'status']) &&
            request.resource.data.clockInAt == resource.data.clockInAt &&
            request.resource.data.createdAt == resource.data.createdAt
          )
        );

        allow delete: if isAdmin() || isHR();
      }

      match /todos/{todoId} {
        allow read: if isUserActive() && (
          isAdmin() || userId == request.auth.uid
        );
        allow create: if isUserActive() && userId == request.auth.uid;
        allow update: if isUserActive() && userId == request.auth.uid;
        allow delete: if isUserActive() && userId == request.auth.uid;
      }
    }

    // Employee Directory (Public read-only for active employees)
    match /employee_directory/{userId} {
      allow read: if isUserActive();
      allow write: if false; // Only backend can update directory
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if canReadTask();
      
      allow create: if isUserActive();
      
      allow update: if isUserActive() && (
        isAdmin() ||
        isRole('manager') ||
        resource.data.assignedBy == request.auth.uid ||
        resource.data.assigned_by == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        (isAssignedToUser(resource.data, request.auth.uid) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updated_at', 'progress', 'completedAt', 'attachments']) &&
         request.resource.data.assignedTo == resource.data.assignedTo &&
         request.resource.data.assignedBy == resource.data.assignedBy)
      );
      
      allow delete: if isAdmin() || resource.data.assignedBy == request.auth.uid;

      // Comments subcollection under tasks/{taskId}
      match /comments/{commentId} {
        allow read: if canAccessParentTask(taskId);
        allow create: if canAccessParentTask(taskId) && request.resource.data.commentedBy == request.auth.uid;
        allow update, delete: if isUserActive() && (
          isAdmin() || resource.data.commentedBy == request.auth.uid
        );
      }

      // History subcollection under tasks/{taskId}
      match /history/{historyId} {
        allow read: if canAccessParentTask(taskId);
        allow create: if isUserActive() && canAccessParentTask(taskId);
        allow update, delete: if isUserActive() && isAdmin();
      }
    }
    
    // Daily Reports (dailyDiary)
    match /dailyDiary/{reportId} {
      allow read: if isUserActive() && (
        isAdmin() || 
        (isManager() && resource.data.managerId == request.auth.uid) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isUserActive() && request.resource.data.userId == request.auth.uid;
      allow update: if isUserActive() && (
        isAdmin() || (
          resource.data.userId == request.auth.uid && 
          request.resource.data.userId == resource.data.userId
        )
      );
      allow delete: if isUserActive() && (isAdmin() || resource.data.userId == request.auth.uid);
    }
    
    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isUserActive() && resource.data.userId == request.auth.uid;
      allow create: if isUserActive() && (
        isAdmin() || isManager() ||
        request.resource.data.fromUserId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isUserActive() && resource.data.userId == request.auth.uid;
    }
    
    // Performance Scores
    match /performance_scores/{scoreId} {
      allow read: if isUserActive() && (
        isManagerOrAbove() || resource.data.userId == request.auth.uid
      );
      allow write: if isManagerOrAbove();
    }

    // Roles collection
    match /roles/{roleId} {
      allow read: if isUserActive();
      allow write: if isAdmin();
    }

    // Audit logs collection
    match /audit_logs/{logId} {
      allow read: if isUserActive() && (isAdmin() || isHR() || isCEO());
      allow create: if isUserActive() && (
        isCEO() ||
        (
          (request.resource.data.performedBy == request.auth.uid || request.resource.data.operator_id == request.auth.uid) &&
          (request.resource.data.createdAt == request.time || !request.resource.data.keys().hasAny(['createdAt'])) &&
          (request.resource.data.timestamp == request.time || !request.resource.data.keys().hasAny(['timestamp']))
        )
      );
      allow update, delete: if isCEO();
    }

    // Change approval queue collection
    match /change_approval_queue/{requestId} {
      allow read: if isUserActive() && (
        isAdmin() || isHR() || 
        resource.data.requested_by == request.auth.uid
      );
      allow write: if isUserActive() && (isAdmin() || isHR());
    }

    // Leave requests collection
    match /leave_requests/{requestId} {
      allow read: if isUserActive() && (
        isAdmin() || isHR() || 
        resource.data.user_id == request.auth.uid
      );
      allow create: if isUserActive() && (
        isAdmin() || isHR() || 
        request.resource.data.user_id == request.auth.uid
      );
      allow update: if isUserActive() && (
        isAdmin() || isHR() || (
          resource.data.user_id == request.auth.uid &&
          request.resource.data.user_id == resource.data.user_id &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reason', 'dates', 'leave_type', 'updated_at', 'updatedAt'])
        )
      );
      allow delete: if isUserActive() && (isAdmin() || isHR());
    }

    // Performance reviews collection
    match /performance_reviews/{reviewId} {
      allow read: if isUserActive() && (isManagerOrAbove() || resource.data.userId == request.auth.uid);
      allow write: if isManagerOrAbove();
    }
    
    // Sales Leads
    match /salesLeads/{leadId} {
      allow read: if isUserActive() && (
        isManagerOrAbove() || resource.data.assignedTo == request.auth.uid
      );
      allow create: if isUserActive();
      allow update: if isUserActive() && (
        isManagerOrAbove() || (
          resource.data.assignedTo == request.auth.uid &&
          request.resource.data.assignedTo == resource.data.assignedTo
        )
      );
      allow delete: if isAdmin();
    }

    // Service Leads
    match /serviceLeads/{leadId} {
      allow read: if isUserActive() && (
        isManagerOrAbove() || resource.data.assignedTo == request.auth.uid
      );
      allow create: if isUserActive();
      allow update: if isUserActive() && (
        isManagerOrAbove() || (
          resource.data.assignedTo == request.auth.uid &&
          request.resource.data.assignedTo == resource.data.assignedTo
        )
      );
      allow delete: if isAdmin();
    }

    // Teams collection (newly secured in Phase 4.2)
    match /teams/{teamId} {
      allow read: if isUserActive() && (
        isAdmin() || isHR() || 
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in resource.data.memberUids
      );
      allow create: if isManagerOrAbove();
      allow update: if isUserActive() && (
        isAdmin() || 
        resource.data.createdBy == request.auth.uid ||
        (isManager() && request.auth.uid in resource.data.memberUids)
      );
      allow delete: if isAdmin();
    }

    // Projects collection (newly secured in Phase 4.2)
    match /projects/{projectId} {
      allow read: if isUserActive() && (
        isAdmin() || isHR() || 
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.memberUids
      );
      allow create: if isManagerOrAbove();
      allow update: if isUserActive() && (
        isAdmin() || 
        resource.data.createdBy == request.auth.uid ||
        (isManager() && request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.memberUids)
      );
      allow delete: if isAdmin();
    }

    // Invitations (newly secured in Phase 4.2)
    match /invites/{inviteId} {
      allow read: if isUserActive() && (
        isAdmin() || isHR() || 
        resource.data.email == request.auth.token.email
      );
      allow create: if isUserActive() && (isAdmin() || isHR());
      allow update: if isUserActive() && (
        isAdmin() || isHR() || (
          resource.data.email == request.auth.token.email &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'accepted_at', 'acceptedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // Locations (newly secured in Phase 4.2)
    match /locations/{locationId} {
      allow read: if isUserActive();
      allow write: if isAdmin();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
