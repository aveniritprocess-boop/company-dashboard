rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    function isCEO() {
      return hasRole('ceo');
    }
    
    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin');
    }
    
    function isManager() {
      return hasRole('manager');
    }

    function isHR() {
      return hasRole('hr') || hasRole('hr_admin') || hasRole('hr_executive');
    }

    // Users collection
    match /users/{userId} {
      // Any signed-in user can read user documents (e.g. for directory visibility, task assignments, and reporting manager lookup)
      allow read: if isSignedIn();
      // Any signed-in user can CREATE their own document (defaults to employee or no role).
      allow create: if isSignedIn() && request.auth.uid == userId && (
        !request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'employee'
      );
      // Users can update their own doc (except role); Admins/CEOs can update anyone's doc.
      allow update: if isSignedIn() && (
        isCEO() || isAdmin() || 
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      // Prevent deletion of CEO
      allow delete: if isAdmin() && resource.data.role != 'ceo';
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isSignedIn() && (
        isCEO() || isAdmin() || 
        (isManager() && (request.auth.uid == resource.data.assignedBy || request.auth.uid in resource.data.assignedTo)) ||
        (request.auth.uid == resource.data.assignedTo || (resource.data.assignedTo is list && request.auth.uid in resource.data.assignedTo))
      );
      
      allow create: if isCEO() || isAdmin() || isManager();
      
      allow update: if isSignedIn() && (
        isCEO() || isAdmin() ||
        (isManager() && resource.data.assignedBy == request.auth.uid) ||
        (request.auth.uid in resource.data.assignedTo && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updated_at']))
      );
      
      allow delete: if isAdmin() || (isCEO() && resource.data.assignedBy == request.auth.uid);
    }
    
    // Daily Reports (used internally as dailyDiary)
    match /dailyDiary/{reportId} {
      allow read: if isSignedIn() && (
        isCEO() || isAdmin() || 
        (isManager() && resource.data.managerId == request.auth.uid) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isCEO() || isAdmin() || resource.data.userId == request.auth.uid
      );
    }
    
    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        isCEO() || isAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isCEO() || isAdmin() || resource.data.userId == request.auth.uid
      );
    }
    
    // Performance Scores
    match /performance_scores/{scoreId} {
      allow read: if isSignedIn() && (
        isCEO() || isAdmin() || isManager() || resource.data.userId == request.auth.uid
      );
      allow write: if isCEO() || isAdmin() || isManager();
    }

    // Roles collection
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isCEO() || isAdmin();
    }

    // Audit logs collection
    match /audit_logs/{logId} {
      allow read: if isSignedIn() && (isCEO() || isAdmin() || isHR());
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Change approval queue collection
    match /change_approval_queue/{requestId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isCEO() || isAdmin() || isHR());
    }

    // Leave requests collection
    match /leave_requests/{requestId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Performance reviews collection
    match /performance_reviews/{reviewId} {
      allow read: if isSignedIn() && (isCEO() || isAdmin() || isManager() || resource.data.userId == request.auth.uid);
      allow write: if isCEO() || isAdmin() || isManager() || isHR();
    }
    
    // Sales Leads
    match /salesLeads/{leadId} {
      allow read: if isSignedIn() && (
        isCEO() || isAdmin() || isManager() || resource.data.assignedTo == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isCEO() || isAdmin() || isManager() || resource.data.assignedTo == request.auth.uid
      );
      allow delete: if isCEO() || isAdmin();
    }

    // Service Leads
    match /serviceLeads/{leadId} {
      allow read: if isSignedIn() && (
        isCEO() || isAdmin() || isManager() || resource.data.assignedTo == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isCEO() || isAdmin() || isManager() || resource.data.assignedTo == request.auth.uid
      );
      allow delete: if isCEO() || isAdmin();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if isCEO();
    }
  }
}
